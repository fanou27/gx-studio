diff --git a/src/gxdebug.cpp b/src/gxdebug.cpp
new file mode 100644
index 0000000..6f774bf
--- /dev/null
+++ b/src/gxdebug.cpp
@@ -0,0 +1,334 @@
+// GX Studio : petit serveur de debogage pour Caprice32.
+//
+// Active par l'option de configuration  devtools.server_port=<port>  (0 = desactive),
+// par exemple :  cap32 -O devtools.server_port=6543 jeu.dsk
+// Ecoute sur 127.0.0.1 uniquement, un seul client a la fois, protocole texte
+// (une commande par ligne, reponses et evenements une ligne chacun) :
+//
+//   hello                     -> OK gxdebug 1
+//   pause | cont              -> STOP pause ... / OK
+//   step                      -> une instruction           -> STOP step  (+ REGS)
+//   over                      -> instruction ou CALL/RST entier -> STOP step
+//   out                       -> jusqu'au RET de la routine -> STOP step
+//   regs                      -> REGS PC=xxxx SP=xxxx AF=... (registres Z80)
+//   mem <adr> <n>             -> MEM <adr> <octets hexa>   (memoire vue par le Z80)
+//   ram <adr> <n>             -> MEM ... (RAM physique : l'ecran meme sous la ROM haute)
+//   psg                       -> PSG r0 r1 ... r15 (registres du PSG)
+//   poke <adr> <octets hexa>  -> OK
+//   bp add <adr> | bp del <adr> | bp clear | bp list -> OK / BP adr adr ...
+//   shot <fichier.png>        -> OK (capture de l'ecran emule)
+//   key <ligne> <bit> <0|1>   -> OK (matrice clavier : 9/6 = manette 1)
+//   quit                      -> ferme l'emulateur
+// Evenement : "STOP <raison> PC=xxxx" quand l'execution s'arrete (raison :
+// bp, step, pause, watch), suivi d'une ligne REGS.
+// Tant qu'un client est connecte, un point d'arret ne pause que l'emulation
+// (la fenetre DevTools ne s'ouvre pas) ; si le client se deconnecte,
+// l'emulation reprend.
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <sstream>
+#include <vector>
+
+// Sockets : POSIX (Linux, macOS) ou Winsock (Windows, MinGW / MSYS2)
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+typedef SOCKET gx_socket;
+#define GX_NO_SOCKET INVALID_SOCKET
+#define GX_NOSIGNAL 0
+static void gx_close(gx_socket s) { closesocket(s); }
+static void gx_nonblock(gx_socket s) { u_long one = 1; ioctlsocket(s, FIONBIO, &one); }
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+typedef int gx_socket;
+#define GX_NO_SOCKET (-1)
+#ifdef MSG_NOSIGNAL
+#define GX_NOSIGNAL MSG_NOSIGNAL
+#else
+#define GX_NOSIGNAL 0                   // macOS : pas de MSG_NOSIGNAL
+#endif
+static void gx_close(gx_socket s) { ::close(s); }
+static void gx_nonblock(gx_socket s) { fcntl(s, F_SETFL, O_NONBLOCK); }
+#endif
+
+#include "SDL.h"
+#include "cap32.h"
+#include "z80.h"
+#include "z80_disassembly.h"
+#include "log.h"
+
+extern t_CPC CPC;
+extern t_z80regs z80;
+extern byte keyboard_matrix[16];
+extern byte *pbRAM;
+extern std::vector<Breakpoint> breakpoints;
+extern SDL_Surface *back_surface;
+#include "savepng.h"
+
+static gx_socket g_listen = GX_NO_SOCKET, g_client = GX_NO_SOCKET;
+static std::string g_in;
+static bool g_stopped = false;         // arret demande par le debogueur
+static std::string g_shot;             // capture demandee (faite a la fin de l'image)
+
+bool gxdebug_connected() { return g_client != GX_NO_SOCKET; }
+
+static void send_line(const std::string& s) {
+  if (g_client == GX_NO_SOCKET) return;
+  std::string l = s + "\n";
+  const char* p = l.c_str();
+  size_t n = l.size();
+  while (n > 0) {
+    int w = ::send(g_client, p, static_cast<int>(n), GX_NOSIGNAL);
+    if (w <= 0) { gx_close(g_client); g_client = GX_NO_SOCKET; return; }
+    p += w; n -= w;
+  }
+}
+
+static std::string hex4(unsigned v) { char b[8]; snprintf(b, sizeof b, "%04X", v & 0xFFFF); return b; }
+static std::string hex2(unsigned v) { char b[4]; snprintf(b, sizeof b, "%02X", v & 0xFF); return b; }
+
+static std::string regs_line() {
+  std::ostringstream o;
+  o << "REGS PC=" << hex4(z80.PC.w.l) << " SP=" << hex4(z80.SP.w.l)
+    << " AF=" << hex4(z80.AF.w.l) << " BC=" << hex4(z80.BC.w.l)
+    << " DE=" << hex4(z80.DE.w.l) << " HL=" << hex4(z80.HL.w.l)
+    << " IX=" << hex4(z80.IX.w.l) << " IY=" << hex4(z80.IY.w.l)
+    << " AF'=" << hex4(z80.AFx.w.l) << " BC'=" << hex4(z80.BCx.w.l)
+    << " DE'=" << hex4(z80.DEx.w.l) << " HL'=" << hex4(z80.HLx.w.l)
+    << " I=" << hex2(z80.I) << " R=" << hex2((z80.R & 0x7F) | (z80.Rb7 & 0x80))
+    << " IM=" << int(z80.IM) << " IFF1=" << (z80.IFF1 ? 1 : 0) << " IFF2=" << (z80.IFF2 ? 1 : 0);
+  return o.str();
+}
+
+static void remove_ephemeral() {
+  breakpoints.erase(std::remove_if(breakpoints.begin(), breakpoints.end(),
+                    [](const Breakpoint& b) { return b.type & EPHEMERAL; }), breakpoints.end());
+}
+
+extern int z80_bp_skip;
+static void stop(const char* reason) {
+  z80_bp_skip = 1;                      // a la reprise, l'instruction de PC s'execute
+  g_stopped = true;
+  CPC.paused = true;
+  z80.step_in = 0;
+  z80.step_out = 0;
+  remove_ephemeral();
+  send_line(std::string("STOP ") + reason + " PC=" + hex4(z80.PC.w.l));
+  send_line(regs_line());
+}
+
+static void resume() {
+  g_stopped = false;
+  CPC.paused = false;
+}
+
+static unsigned parse_num(const std::string& s) {
+  std::string t = s;
+  int base = 16;
+  if (!t.empty() && (t[0] == '#' || t[0] == '&' || t[0] == '$')) t = t.substr(1);
+  else if (t.size() > 2 && t[0] == '0' && (t[1] == 'x' || t[1] == 'X')) t = t.substr(2);
+  return static_cast<unsigned>(strtoul(t.c_str(), nullptr, base));
+}
+
+static void command(const std::string& line) {
+  std::istringstream in(line);
+  std::string c;
+  in >> c;
+  if (c.empty()) return;
+  if (c == "hello") send_line("OK gxdebug 1");
+  else if (c == "pause") stop("pause");
+  else if (c == "cont") { remove_ephemeral(); resume(); send_line("OK"); }
+  else if (c == "step") { z80.step_in = 1; resume(); }
+  else if (c == "over") {
+    std::vector<dword> eps;
+    DisassembledCode code;
+    auto cur = disassemble_one(z80.PC.w.l, code, eps);
+    const std::string& ins = cur.instruction_;
+    bool call = ins.rfind("call", 0) == 0 || ins.rfind("rst", 0) == 0
+             || ins.rfind("ldir", 0) == 0 || ins.rfind("lddr", 0) == 0
+             || ins.rfind("cpir", 0) == 0 || ins.rfind("cpdr", 0) == 0
+             || ins.rfind("inir", 0) == 0 || ins.rfind("otir", 0) == 0
+             || ins.rfind("indr", 0) == 0 || ins.rfind("otdr", 0) == 0
+             || ins.rfind("djnz", 0) == 0 || ins.rfind("halt", 0) == 0;
+    if (call) breakpoints.emplace_back(static_cast<word>(z80.PC.w.l + cur.Size()), EPHEMERAL);
+    else z80.step_in = 1;
+    resume();
+  }
+  else if (c == "out") { z80.step_out = 1; z80.step_out_addresses.clear(); resume(); }
+  else if (c == "regs") send_line(regs_line());
+  else if (c == "mem") {
+    std::string a, n;
+    in >> a >> n;
+    unsigned adr = parse_num(a), len = n.empty() ? 16 : strtoul(n.c_str(), nullptr, 10);
+    if (len > 4096) len = 4096;
+    std::string out = "MEM " + hex4(adr) + " ";
+    for (unsigned i = 0; i < len; i++) out += hex2(z80_read_mem(static_cast<word>(adr + i)));
+    send_line(out);
+  }
+  else if (c == "ram") {                 // ram <adr> <n> : RAM physique (64 premiers Ko), ex. l'ecran
+    std::string a, n;                     // quand la ROM haute masque &C000 en lecture
+    in >> a >> n;
+    unsigned adr = parse_num(a), len = n.empty() ? 16 : strtoul(n.c_str(), nullptr, 10);
+    if (len > 4096) len = 4096;
+    std::string out = "MEM " + hex4(adr) + " ";
+    for (unsigned i = 0; i < len; i++) out += hex2(pbRAM[(adr + i) & 0xFFFF]);
+    send_line(out);
+  }
+  else if (c == "psg") {                 // registres du PSG (son)
+    extern t_PSG PSG;
+    std::string out = "PSG";
+    for (int i = 0; i < 16; i++) out += " " + hex2(PSG.RegisterAY.Index[i]);
+    send_line(out);
+  }
+  else if (c == "poke") {
+    std::string a, h;
+    in >> a >> h;
+    unsigned adr = parse_num(a);
+    for (size_t i = 0; i + 1 < h.size(); i += 2)
+      z80_write_mem(static_cast<word>(adr + i / 2), static_cast<byte>(strtoul(h.substr(i, 2).c_str(), nullptr, 16)));
+    send_line("OK");
+  }
+  else if (c == "bp") {
+    std::string op, a;
+    in >> op >> a;
+    if (op == "add") {
+      word adr = static_cast<word>(parse_num(a));
+      if (std::none_of(breakpoints.begin(), breakpoints.end(), [&](const Breakpoint& b) { return b.address == adr && b.type == NORMAL; }))
+        breakpoints.emplace_back(adr);
+      send_line("OK");
+    } else if (op == "del") {
+      word adr = static_cast<word>(parse_num(a));
+      breakpoints.erase(std::remove_if(breakpoints.begin(), breakpoints.end(),
+                        [&](const Breakpoint& b) { return b.address == adr && b.type == NORMAL; }), breakpoints.end());
+      send_line("OK");
+    } else if (op == "clear") {
+      breakpoints.erase(std::remove_if(breakpoints.begin(), breakpoints.end(),
+                        [](const Breakpoint& b) { return b.type == NORMAL; }), breakpoints.end());
+      send_line("OK");
+    } else {
+      std::string out = "BP";
+      for (auto& b : breakpoints) if (b.type == NORMAL) out += " " + hex4(b.address);
+      send_line(out);
+    }
+  }
+  else if (c == "shot") {             // capture a la fin de l'image (sprites compris)
+    std::string f;
+    std::getline(in, f);
+    f.erase(0, f.find_first_not_of(' '));
+    if (CPC.paused) send_line(SDL_SavePNG(back_surface, f) == 0 ? "OK" : "ERR shot");
+    else g_shot = f;
+  }
+  else if (c == "key") {                 // key <ligne> <bit> <1=appuye|0> : clavier / manette
+    int r = -1, b = -1, v = 0;
+    in >> r >> b >> v;
+    if (r >= 0 && r < 16 && b >= 0 && b < 8) {
+      if (v) keyboard_matrix[r] &= ~(1 << b); else keyboard_matrix[r] |= (1 << b);
+      send_line("OK");
+    } else send_line("ERR key");
+  }
+  else if (c == "prof") {                // prof on|off|clear|save <fichier> : cycles (T-states) executes par adresse
+    extern unsigned int g_prof[65536]; extern int g_prof_on;
+    std::string op, f; in >> op; std::getline(in, f); f.erase(0, f.find_first_not_of(' '));
+    if (op == "on") g_prof_on = 1;
+    else if (op == "off") g_prof_on = 0;
+    else if (op == "clear") memset(g_prof, 0, sizeof(g_prof));
+    else if (op == "save") {
+      FILE *o = fopen(f.c_str(), "wb");
+      if (!o) { send_line("ERR prof"); return; }
+      fwrite(g_prof, sizeof(g_prof[0]), 65536, o);
+      fclose(o);
+    } else { send_line("ERR prof"); return; }
+    send_line("OK");
+  }
+  else if (c == "quit") { send_line("OK"); cleanExit(0, false); }
+  else send_line("ERR commande inconnue : " + c);
+}
+
+void gxdebug_init(int port) {
+  if (port <= 0) return;
+#ifdef _WIN32
+  WSADATA wsa;
+  if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) return;
+#endif
+  g_listen = ::socket(AF_INET, SOCK_STREAM, 0);
+  if (g_listen == GX_NO_SOCKET) return;
+  int one = 1;
+  setsockopt(g_listen, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&one), sizeof one);
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_port = htons(static_cast<uint16_t>(port));
+  a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  if (::bind(g_listen, reinterpret_cast<sockaddr*>(&a), sizeof a) < 0 || ::listen(g_listen, 1) < 0) {
+    LOG_ERROR("gxdebug : port " << port << " indisponible");
+    gx_close(g_listen);
+    g_listen = GX_NO_SOCKET;
+    return;
+  }
+  gx_nonblock(g_listen);
+  LOG_INFO("gxdebug : serveur de debogage sur 127.0.0.1:" << port);
+  fprintf(stderr, "GXDEBUG %d\n", port);
+}
+
+// A appeler a chaque tour de la boucle principale (en pause ou non).
+void gxdebug_poll() {
+  if (g_listen == GX_NO_SOCKET) return;
+  if (g_client == GX_NO_SOCKET) {
+    gx_socket c = ::accept(g_listen, nullptr, nullptr);
+    if (c != GX_NO_SOCKET) {
+      gx_nonblock(c);
+      g_client = c;
+      g_in.clear();
+    }
+  }
+  if (g_client != GX_NO_SOCKET) {
+    char buf[1024];
+    for (;;) {
+      int n = ::recv(g_client, buf, sizeof buf, 0);
+      if (n > 0) { g_in.append(buf, n); continue; }
+      if (n == 0) { gx_close(g_client); g_client = GX_NO_SOCKET; resume(); }   // client parti : on repart
+      break;
+    }
+    size_t p;
+    while (g_client != GX_NO_SOCKET && (p = g_in.find('\n')) != std::string::npos) {
+      std::string l = g_in.substr(0, p);
+      g_in.erase(0, p + 1);
+      if (!l.empty() && l.back() == '\r') l.pop_back();
+      command(l);
+    }
+  }
+  if (g_stopped) CPC.paused = true;      // la pause automatique (focus) ne relance pas
+}
+
+// Apres z80_execute : true si l'arret a ete pris en charge par le debogueur.
+bool gxdebug_after_exec(int exitCondition) {
+  if (g_client == GX_NO_SOCKET || exitCondition != EC_BREAKPOINT) return false;
+  if (z80.watchpoint_reached) { stop("watch"); return true; }
+  if (z80.breakpoint_reached) {
+    bool eph = std::any_of(breakpoints.begin(), breakpoints.end(),
+                           [](const Breakpoint& b) { return (b.type & EPHEMERAL) && b.address == z80.PC.w.l; });
+    stop(eph ? "step" : "bp");
+    return true;
+  }
+  if (z80.step_in > 1) { stop("step"); return true; }
+  return false;
+}
+
+// Fin d'une image (sprites dessines) : capture demandee par "shot".
+void gxdebug_frame_done() {
+  if (g_shot.empty()) return;
+  send_line(SDL_SavePNG(back_surface, g_shot) == 0 ? "OK" : "ERR shot");
+  g_shot.clear();
+}
